# Cloudflare Pages response headers.
#
# The site currently runs in SMS FORM SIMULATION MODE: the opt-in and opt-out
# forms reproduce the finished customer experience in the browser, but no data
# is transmitted or stored. See the comment block at the top of
# /assets/js/sms-forms.js and the "Current status" section of README.md.
#
# The Content-Security-Policy below enforces that at the browser level:
#   connect-src 'none'  -> the page cannot make any network request (no fetch/XHR),
#                          so a phone number physically cannot leave the browser.
#   form-action 'none'  -> no form can POST anywhere.
#
# WHEN THE BACKEND IS ADDED: change connect-src to 'self' so the opt-in and
# opt-out handlers in /assets/js/sms-forms.js can call the API.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
